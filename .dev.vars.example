# Copy to .dev.vars for local `wrangler dev` (never commit the real file).
# In production these are set with `wrangler secret put <NAME>`.

ADMIN_API_KEY=change-me-admin-key
SESSION_JWT_SECRET=change-me-session-secret-min-32-chars

# Cloudflare Realtime TURN service (Dashboard > Realtime > TURN > Create TURN key)
TURN_KEY_ID=change-me-turn-key-id
TURN_KEY_API_TOKEN=change-me-turn-key-api-token
